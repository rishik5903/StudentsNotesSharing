frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- Environment / credentials ----
.env
.env.local
*.env

# ---- IDE ----
.idea/
*.iml
.vscode/settings.json
*.DS_Store
__MACOSX/

# ---- OS ----
.DS_Store
Thumbs.db

